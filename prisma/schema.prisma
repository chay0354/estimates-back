generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SALES
  MANAGER
  ADMIN
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(SALES)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  estimates    Estimate[] @relation("assignedUser")
  events       EstimateEvent[]
}

model Installer {
  id        String     @id @default(cuid())
  name      String
  active    Boolean    @default(true)
  estimates Estimate[] @relation("estimateInstallers")
}

model Customer {
  id        String     @id @default(cuid())
  name      String
  contacts  Contact[]
  addresses Address[]
  estimates Estimate[]
  createdAt DateTime   @default(now())
}

model Contact {
  id         String     @id @default(cuid())
  name       String
  phone      String?
  email      String?
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  estimates  Estimate[]
}

model Address {
  id         String     @id @default(cuid())
  line       String
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  estimates  Estimate[]
}

model MarketingSource {
  id        String     @id @default(cuid())
  name      String     @unique
  active    Boolean    @default(true)
  estimates Estimate[]
}

model EstimateType {
  id        String     @id @default(cuid())
  name      String     @unique
  active    Boolean    @default(true)
  estimates Estimate[]
}

model Estimate {
  id                String    @id @default(cuid())
  estimateNumber    String    @unique
  estimateLink      String
  estimateDate      DateTime
  estimateAmount    Decimal   @db.Decimal(12, 2)

  // denormalised contact snapshot: the estimate keeps what was true at creation time
  phone             String
  email             String?

  customer          Customer  @relation(fields: [customerId], references: [id])
  customerId        String
  contact           Contact   @relation(fields: [contactId], references: [id])
  contactId         String
  address           Address   @relation(fields: [addressId], references: [id])
  addressId         String
  marketingSource   MarketingSource @relation(fields: [marketingSourceId], references: [id])
  marketingSourceId String
  estimateType      EstimateType    @relation(fields: [estimateTypeId], references: [id])
  estimateTypeId    String
  assignedUser      User      @relation("assignedUser", fields: [assignedUserId], references: [id])
  assignedUserId    String

  commissionStructure String  // "HVAC" | "Repair" | "Membership Only"
  status              String  // see constants/enums.js ESTIMATE_STATUSES
  converted           Boolean @default(false)

  // job fields — only set when converted = true
  jobStatus  String?          // see JOB_STATUSES
  jobLink    String?
  jobDate    DateTime?
  jobAmount  Decimal?         @db.Decimal(12, 2)
  installers Installer[]      @relation("estimateInstallers")

  events    EstimateEvent[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([estimateDate])
  @@index([assignedUserId])
  @@index([converted])
}

model EstimateEvent {
  id         String   @id @default(cuid())
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  estimateId String
  field      String
  from       String?
  to         String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorId    String?
  createdAt  DateTime @default(now())

  @@index([estimateId])
}
